{
  "name": "cdn-link-studio",
  "version": "2.0.0",
  "description": "CDN Link Studio: scan GitHub repos for SVGs, generate multi-CDN links, validate them.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit",
    "svg": "vite build && node scripts/make-svg.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.3"
  }
}
